generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  devices      Device[]
}

enum DeviceType {
 LIGHT
 AIR_CONDITIONER
 TV
}
model Device {
 id String @id @default(uuid())
 ownerId String
 owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
 name String
 type DeviceType
 room String?
 isOn Boolean @default(false)
 brightness Int?
 temperature Int?
 channel Int?
 volume Int?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([ownerId])
}
